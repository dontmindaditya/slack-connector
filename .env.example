# =============================================================================
# Collectium Slack MCP — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# =============================================================================


# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
APP_NAME="Collectium Slack MCP"
APP_ENV=development                         # development | staging | production
APP_HOST=0.0.0.0
APP_PORT=8003
DEBUG=false
LOG_LEVEL=INFO                              # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=text                             # text (dev) | json (production)

# Allowed CORS origins — JSON array of strings
ALLOWED_ORIGINS=["*"]

# Secret key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=


# -----------------------------------------------------------------------------
# Slack
# Find these at: https://api.slack.com/apps → Your App → Basic Information
# -----------------------------------------------------------------------------

# The app's Client ID (public — safe to check into non-.env config)
SLACK_CLIENT_ID=

# The app's Client Secret (secret — never expose)
SLACK_CLIENT_SECRET=

# Signing Secret — used to verify X-Slack-Signature on every webhook request
SLACK_SIGNING_SECRET=

# OAuth redirect URI — must match exactly what you set in:
#   api.slack.com → Your App → OAuth & Permissions → Redirect URLs
# Local dev: use ngrok or similar to get a public HTTPS URL
SLACK_REDIRECT_URI=your-url/api/oauth/callback
# SLACK_REDIRECT_URI=http://localhost:8000/api/oauth/callback  # local only


# -----------------------------------------------------------------------------
# Supabase
# Find these at: https://app.supabase.com → Project → Settings → API
# -----------------------------------------------------------------------------

# Project URL (e.g. https://abcdefghij.supabase.co)
SUPABASE_URL=

# Anon/public key — safe for client-side use (RLS protects data)
SUPABASE_ANON_KEY=

# Service-role key — bypasses RLS, used only by the backend
# KEEP THIS SECRET — treat it like a root database password
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Retry / rate-limit tuning (optional — defaults are sensible)
# -----------------------------------------------------------------------------

# Number of retry attempts for rate-limited Slack API calls (0 = no retries)
SLACK_MAX_RETRIES=3

# Base delay in seconds for exponential backoff between retries
SLACK_RETRY_BASE_DELAY=1.0
